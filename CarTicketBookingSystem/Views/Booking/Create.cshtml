@model CarTicketBookingSystem.Models.Booking

@{
    Layout = null;

    var route = ViewBag.Route as CarTicketBookingSystem.Models.TravelRoute;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Book Your Ticket</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="card shadow-sm mx-auto" style="max-width: 650px;">

            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0">Book Your Ticket</h4>
            </div>

            <div class="card-body p-4">

                @if (route != null)
                {
                    <div class="alert alert-info">
                        <h5 class="mb-2">
                            @route.From → @route.To
                        </h5>

                        <p class="mb-1">
                            Travel Time: @route.TravelTime
                        </p>

                        <strong>
                            Fare: ৳@route.Fare
                        </strong>
                    </div>
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <form asp-controller="Booking"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="TravelRouteId" />

                    <div class="mb-3">
                        <label asp-for="PassengerName"
                               class="form-label">
                            Passenger Name
                        </label>

                        <input asp-for="PassengerName"
                               class="form-control"
                               placeholder="Enter passenger name" />

                        <span asp-validation-for="PassengerName"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone"
                               class="form-label">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               class="form-control"
                               placeholder="Enter phone number" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TravelDate"
                               class="form-label">
                            Travel Date
                        </label>

                        <input asp-for="TravelDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="TravelDate"
                              class="text-danger">
                        </span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Confirm Booking
                    </button>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary w-100 mt-2">
                        Back to Routes
                    </a>

                </form>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>